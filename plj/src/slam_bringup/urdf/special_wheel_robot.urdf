<?xml version="1.0"?>
<robot name="special_wheel_robot">
  <link name="base_link"/>
  <link name="unilidar_lidar"/>
  <link name="unilidar_imu"/>

  <joint name="base_to_unilidar_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="unilidar_lidar"/>
    <origin xyz="0.15 0.0 0.25" rpy="0.0 -0.26 0.0"/>
  </joint>

  <joint name="unilidar_lidar_to_imu" type="fixed">
    <parent link="unilidar_lidar"/>
    <child link="unilidar_imu"/>
    <origin xyz="0.0077 0.0147 -0.0067" rpy="0.0 0.0 0.0"/>
  </joint>
</robot>
