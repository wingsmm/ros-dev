# xtark Qt Client local runtime config (与 pc/qt_client/.env 对齐；改一处请同步另一处)

# 机器人连接 / JSON 网关
XTARK_HOST=192.168.1.168
XTARK_BACKEND=json_gateway
XTARK_JSON_PORT=8765
XTARK_GATEWAY_URI=192.168.1.168:8765
XTARK_LINEAR_SPEED=0.12
XTARK_ANGULAR_SPEED=0.50

# 摄像头 HTTP 预览
XTARK_MJPEG_URL=http://192.168.1.168:8080/stream?topic=/camera/image_raw
XTARK_DEPTH_RAW_URL=http://192.168.1.168:8082/v1/depth/latest
CAMERA_SNAPSHOT_DIR=data/camera_snapshots
CAMERA_QT_PREVIEW_ENABLE=0

# 日志
XTARK_LOG_DIR=logs
XTARK_LOG_LEVEL=INFO
XTARK_LOG_RETENTION_DAYS=30
XTARK_LOG_ODOM=0
XTARK_LOG_ODOM_INTERVAL=1.0

# 摄像头页 · 地面感知
GROUND_OVERLAY_ENABLE=1
GROUND_OVERLAY_METHOD=trapezoid
GROUND_TRAPEZOID_BOTTOM_Y_RATIO=0.02
GROUND_TRAPEZOID_TOP_Y_RATIO=0.4
GROUND_TRAPEZOID_TOP_WIDTH_RATIO=0.4
GROUND_CORRIDOR_WIDTH_M=0.24
GROUND_OBSTACLE_RANGE_M=2.0
GROUND_STAIR_RANGE_M=2.5
GROUND_OVERLAY_MAX_RANGE_M=5.0
GROUND_PERCEPTION_MAX_FPS=5

# RViz 渲染：0=硬件 OpenGL，1=软件渲染兜底
XTARK_RVIZ_SOFTWARE_GL=0
XTARK_RVIZ_NICE=10

# 深度点云诊断；只用于 RViz 观察，不接入导航
CAMERA_POINTCLOUD_ENABLE=1
CAMERA_POINTCLOUD_MAX_FPS=1
CAMERA_POINTCLOUD_STRIDE=12
CAMERA_POINTCLOUD_MIN_RANGE_M=0.25
CAMERA_POINTCLOUD_MAX_RANGE_M=3.0
CAMERA_POINTCLOUD_REQUIRE_SUBSCRIBER=1
CAMERA_DEPTH_RAW_REQUIRE_SUBSCRIBER=1

# 深度相机内参；geometric/depth 贴地投影使用
DEPTH_FX=578.579084625938
DEPTH_FY=579.3575953496057
DEPTH_CX=679.1573216382707
DEPTH_CY=323.1467217747702

# base_link -> camera_link 外参；点云/geometric 使用。x前 y左 z上；角度单位 rad。
CAMERA_X=0.10
CAMERA_Y=0.0
CAMERA_Z=0.20
CAMERA_ROLL=0.0
CAMERA_PITCH=-0.01
CAMERA_YAW=0.0

# ==================== 2D 雷达页 · 人工避障 / SafeMode ====================
QT_WARNING_ENABLE=1
QT_WARNING_SAFEMODE=1
QT_WARNING_MIN_DISTANCE_M=3.0
QT_WARNING_FRONT_HALF_ANGLE_DEG=40
QT_WARNING_MIN_VALID_RANGE_M=0.25
# ========================================================================

# ==================== VMware Qt client（ROS1 VM 专用）====================
# ROS Master（默认由 XTARK_HOST 推导；显式覆盖时取消注释）
ROS_MASTER_URI=http://192.168.1.168:11311
# 本机 ROS 节点 IP；不设则自动检测 VM 网卡
# ROS_IP=192.168.1.154
# PC_NET_IF=ens33

# VM 无 WSLg，RViz 建议软件渲染（覆盖上文 XTARK_RVIZ_SOFTWARE_GL）
XTARK_RVIZ_SOFTWARE_GL=1

# 遥控：VM 本地发布 /cmd_vel（线角速度见上文 XTARK_LINEAR_SPEED / XTARK_ANGULAR_SPEED）
CMD_VEL_TOPIC=/cmd_vel
TELEOP_REPEAT_HZ=10
TELEOP_ENABLE_KEYBOARD=1

# 深度增强：VM 补 static TF（真机无 base_link→camera 时用）
ROBOT_BASE_FRAME=base_link
CAMERA_FRAME=camera_link
CAMERA_OPTICAL_FRAME=camera_depth_optical_frame
CAMERA_TF_ENABLE=1
# ========================================================================
