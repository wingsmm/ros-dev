<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/slam_float_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/slam_float_menu_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="6dp"
        android:background="@drawable/slam_panel_bg_floating"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="3dp"
            android:text="@string/slam_nav_section_pick"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_set_a_button"
                android:layout_width="72dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_a"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/slam_nav_set_a"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <Button
                android:id="@+id/slam_set_b_button"
                android:layout_width="72dp"
                android:layout_height="34dp"
                android:background="@drawable/slam_btn_b"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/slam_nav_set_b"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/slam_cancel_pick_button"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/slam_btn_neutral"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/slam_nav_cancel_pick"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingBottom="3dp"
            android:text="@string/slam_nav_section_go"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_go_b_button"
                android:layout_width="68dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_nav"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/slam_nav_go_b"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/slam_return_a_button"
                android:layout_width="68dp"
                android:layout_height="34dp"
                android:background="@drawable/slam_btn_nav"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/slam_nav_return_a"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_round_trip_button"
                android:layout_width="68dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_nav"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/slam_nav_round_trip"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/slam_cancel_nav_button"
                android:layout_width="68dp"
                android:layout_height="34dp"
                android:background="@drawable/slam_btn_cancel"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:text="@string/slam_nav_cancel"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingBottom="3dp"
            android:text="@string/slam_nav_section_multi"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_mode_ab_button"
                android:layout_width="72dp"
                android:layout_height="30dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_neutral"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_nav_mode_ab"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/slam_mode_multi_button"
                android:layout_width="72dp"
                android:layout_height="30dp"
                android:background="@drawable/slam_btn_neutral"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_nav_mode_multi"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_multi_clear_button"
                android:layout_width="68dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_neutral"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_multi_clear"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/slam_multi_start_button"
                android:layout_width="68dp"
                android:layout_height="32dp"
                android:background="@drawable/slam_btn_nav"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_multi_start"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_multi_stop_button"
                android:layout_width="68dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_cancel"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_multi_stop"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <CheckBox
                android:id="@+id/slam_multi_loop_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="@string/slam_multi_loop"
                android:textColor="@android:color/white"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingBottom="3dp"
            android:text="@string/slam_nav_section_view"
            android:textColor="#99FFFFFF"
            android:textSize="10sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/slam_map_recenter_button"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/slam_btn_neutral"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_map_recenter"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/slam_map_export_button"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:background="@drawable/slam_btn_neutral"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="@string/slam_map_debug_export"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/slam_float_anchor"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/slam_fab_anchor"
        android:contentDescription="@string/slam_float_menu_anchor">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:background="@drawable/slam_fab_anchor_dot" />
    </FrameLayout>

</LinearLayout>
