# cp .env.example .env

BASE_IMAGE=ros:humble-ros-base-jammy
DEPS_IMAGE=ros-humble-astra:deps
ASTRA_IMAGE=ros-humble-astra:deps

ROS2_WS=/home/marvsmart/ros2_ws
UVC_PRODUCT_ID=1282
USE_UVC=true
# RK3568：Astra 彩色在 video9/10，video0～8 为板载 RKISP（见文档 §7.1）
VIDEO0=/dev/video9
VIDEO1=/dev/video10
MEDIA0=/dev/media0
# 雷达：容器通过 /dev:/host_dev 访问宿主机串口；不需要雷达时 ENABLE_LIDAR=false
ENABLE_LIDAR=true
LIDAR_SERIAL=/host_dev/ttyUSB0
LIDAR_WAIT_SECONDS=30
SENSOR_LOG_DIR=/var/log/sensor_stack
