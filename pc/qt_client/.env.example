# 本文件用于示例，不要提交 .env（已在仓库 .gitignore 忽略）
#
# 常用（请写在下面独立行，不要留在注释里）：
#   XTARK_BACKEND=json_gateway
#   XTARK_MJPEG_URL=http://192.168.1.169:8080/stream?topic=/camera/image_raw

XTARK_HOST=192.168.1.169
XTARK_BACKEND=json_gateway
XTARK_JSON_PORT=8765
XTARK_LINEAR_SPEED=0.10
XTARK_ANGULAR_SPEED=0.20

# 可选：覆盖 gateway_uri / mjpeg url
# XTARK_GATEWAY_URI=192.168.1.169:8765
XTARK_MJPEG_URL=http://192.168.1.169:8080/stream?topic=/camera/image_raw

# 日志目录；相对路径以 pc/qt_client 为基准
XTARK_LOG_DIR=logs

# DEBUG / INFO / WARNING / ERROR
XTARK_LOG_LEVEL=INFO

# 保留最近多少个自然日
XTARK_LOG_RETENTION_DAYS=30

# 1 开启三路 odom 采样落盘（INFO 级别，按间隔节流，不刷整帧 JSON）
XTARK_LOG_ODOM=0

# 每路 odom 最小采样间隔（秒）
XTARK_LOG_ODOM_INTERVAL=1.0

# 仅当必须打开 deprecated legacy 调试台时设为 1（配合 ./run.sh --legacy）
# XTARK_ALLOW_LEGACY=1

# 进入机器人页时自动启动 ROS2 Bridge；设为 0 则完全手动
# XTARK_AUTO_BRIDGE=0

# 进入摄像头页时自动启动 Camera Bridge；默认 0（手动）。需要时设为 1
# XTARK_AUTO_CAMERA_BRIDGE=1

# WSL 下 RViz2 子进程默认 LIBGL_ALWAYS_SOFTWARE=1；原生 Linux 可设 0
# XTARK_RVIZ_SOFTWARE_GL=0
