# Jetson cockpit local runtime config (VMware/VM 观测端，不入库密钥)

# ROS2
ROS_DOMAIN_ID=0
CMD_VEL_TOPIC=/cmd_vel
CONTROL_ACTION_TOPIC=/vehicle/control_action

# Teleop: dry-run /cmd_vel values
TELEOP_LINEAR_SPEED=1.0
TELEOP_ANGULAR_SPEED=1.0
TELEOP_REPEAT_HZ=10
TELEOP_ENABLE_KEYBOARD=1

# Logs
JETSON_COCKPIT_LOG_DIR=logs
JETSON_COCKPIT_LOG_LEVEL=INFO

# Lidar observation (VM rviz2)
# JETSON_SSH_* 必填：VM 上 cockpit 经 SSH 启停 Jetson L1 / 定位栈
LIDAR_CLOUD_TOPIC=/unilidar/cloud
LIDAR_CLOUD_ALIGNED_TOPIC=/unilidar/cloud_aligned
LIDAR_IMU_TOPIC=/unilidar/imu
LIDAR_FIXED_FRAME=odom
LIDAR_RVIZ_CONFIG=config/unilidar.rviz
LIDAR_BASE_RVIZ_CONFIG=config/unilidar_base.rviz
LIDAR_MAPPING_RVIZ_CONFIG=config/unilidar_mapping.rviz
LIO_ODOM_TOPIC=/odom
LIO_PATH_TOPIC=/odom_path
LIO_CLOUD_REGISTERED_TOPIC=/cloud_registered
LIO_FIXED_FRAME=odom

# Jetson SSH (VM 本地 .env，deploy 不覆盖已有文件)
JETSON_SSH_HOST=
JETSON_SSH_USER=nvidia
JETSON_SSH_PORT=22
JETSON_SSH_PASSWORD=
JETSON_SSH_KEY=
JETSON_REMOTE_ROS2_WS=~/qt/ros2_ws
