# Jetson 本机 Qt 控制台（~/qt/cockpit），不入库密钥

ROS_DOMAIN_ID=0
CMD_VEL_TOPIC=/cmd_vel
CONTROL_ACTION_TOPIC=/vehicle/control_action

TELEOP_LINEAR_SPEED=1.0
TELEOP_ANGULAR_SPEED=1.0
TELEOP_REPEAT_HZ=10
TELEOP_ENABLE_KEYBOARD=1

QT_COCKPIT_LOG_DIR=logs
QT_COCKPIT_LOG_LEVEL=INFO

# car_web 页面（本机浏览器打开）；空则隐藏「Web控制」按钮
WEB_CONTROL_URL=http://172.0.0.82:8080/ctl
